# ─── Public (safe to expose via VITE_ prefix) ─────────────────────────────────
# The public URL of your deployed app (no trailing slash)
VITE_APP_URL=https://your-domain.vercel.app

# Cashfree environment: "sandbox" for testing, "production" for live payments
VITE_CASHFREE_ENV=sandbox

# ─── Server-only secrets (NEVER prefix with VITE_) ────────────────────────────

# Supabase — project URL and service-role key
# The service-role key bypasses Row Level Security.
# It MUST stay server-only and never be sent to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cashfree Payment Gateway — server credentials
# NEVER expose these to the client.
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=your-cashfree-app-id
CASHFREE_CLIENT_SECRET=your-cashfree-secret-key
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret

# License token — JWT signing secret (min 32 chars, high entropy)
# Used to sign device license tokens issued after activation.
LICENSE_TOKEN_SECRET=change-me-to-a-long-random-string-minimum-32-chars
LICENSE_TOKEN_EXPIRY_DAYS=7

# Activation code HMAC key — used to hash activation codes before storing
# Must be different from LICENSE_TOKEN_SECRET
ACTIVATION_CODE_SECRET=change-me-to-another-long-random-string-min-32-chars

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Resend API key: https://resend.com/api-keys
# IMPORTANT: The FROM domain must be verified in Resend dashboard.
# Gmail addresses (@gmail.com) cannot be used as FROM without domain verification.
# Use a custom domain email OR Resend's test address: onboarding@resend.dev
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@your-verified-domain.com
SUPPORT_EMAIL=support@your-domain.com

# ─── Product config ────────────────────────────────────────────────────────────
# Price in INR paise? No — this is full rupees (e.g., 299 for ₹299)
# This is the authoritative price. It is NEVER read from client input.
NEO_BROWSER_PRICE_INR=299
NEO_BROWSER_PRODUCT_ID=neo-browser-individual

# ─── Server port (local development only) ─────────────────────────────────────
PORT=3001

# ─── Desktop App Config (Public / Safe — no secrets) ─────────────────────────
LICENSE_API_BASE_URL=http://localhost:3001
LICENSE_OFFLINE_GRACE_DAYS=7

